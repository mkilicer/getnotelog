{
  "name": "notelog",
  "version": "0.1.0",
  "description": "Memory for your AI. A local MCP server that keeps notes as plain Markdown files and finds them again.",
  "license": "MIT",
  "author": "Muharrem Kılıçer <muharrem@rebkin.com>",
  "homepage": "https://getnotelog.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mkilicer/notelog.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "claude-code",
    "codex",
    "cursor",
    "memory",
    "notes",
    "markdown"
  ],
  "type": "module",
  "bin": {
    "notelog": "dist/cli.js"
  },
  "files": [
    "dist",
    "skill",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-reporter=spec 'test/*.test.ts'",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
